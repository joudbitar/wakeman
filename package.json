{
  "name": "xerb",
  "version": "0.3.1",
  "description": "On-demand local dev-server proxy: every project gets a permanent .localhost URL that wakes its dev server on request and sleeps it when idle.",
  "type": "module",
  "bin": {
    "xerb": "bin/xerb.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "lib/pty.py",
    "lib/vendor/",
    "!lib/__pycache__",
    "xerb.mjs",
    "scan.mjs",
    "serve_static.py",
    ".claude/skills/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joudbitar/xerb.git"
  },
  "homepage": "https://github.com/joudbitar/xerb#readme",
  "bugs": {
    "url": "https://github.com/joudbitar/xerb/issues"
  },
  "keywords": [
    "dev-server",
    "proxy",
    "localhost",
    "on-demand",
    "reverse-proxy",
    "local-development"
  ],
  "author": "Joud Bitar",
  "license": "MIT"
}
